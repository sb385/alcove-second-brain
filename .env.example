# Copy this file to .env and fill in the values. .env is git-ignored.

# --- You ---
ME_NAME=Your Name
# Every address you send/receive as, comma-separated (used to decide what is "on me")
ME_EMAILS=sb@alcoverealty.in
TIMEZONE=Asia/Kolkata

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# --- Gmail (Google OAuth, Desktop app client) ---
GOOGLE_CLIENT_SECRETS=secrets/credentials.json
GOOGLE_TOKEN_FILE=secrets/token.json
# Extra Gmail search filter applied on top of the 24h window
GMAIL_QUERY=-category:promotions -category:social -in:chats
GMAIL_MAX_MESSAGES=300

# --- Google Calendar (same OAuth client as Gmail) ---
# Comma-separated calendar IDs; "primary" is your main calendar.
# Add shared calendars (e.g. an EA-managed one) by their ID from Calendar settings.
CALENDAR_IDS=primary

# --- Wispr Flow (read from its local database on this PC; no API key) ---
# Leave blank for the default %APPDATA%\Wispr Flow
WISPR_DIR=
# Meetings recorded by Flow are always included. Notes you write in Flow:
WISPR_INCLUDE_NOTES=true
# Everything you dictate into any app (emails, WhatsApp, docs). Useful, but
# it also includes anything private you've dictated. Off by default.
WISPR_INCLUDE_DICTATIONS=false

# --- Outputs ---
DATA_DIR=data
DASHBOARD_HTML=output/dashboard.html
LOOKBACK_HOURS=24

# --- WhatsApp (claude.ai WhatsApp connector, used through Claude Code) ---
# Your own WhatsApp number, digits with country code. Summaries go to your
# "message yourself" chat, and that chat is never read back as a source.
ME_PHONE=
# Read your chats each morning
WHATSAPP_SYNC=true
# Send the morning summary: claude | cloudapi | none
WHATSAPP_SEND_VIA=claude
# Optional: path to claude.exe (auto-detected from PATH or the VS Code extension)
CLAUDE_CLI=
# Optional: model for the headless Claude runs, e.g. sonnet (default: your Claude Code default)
CLAUDE_CLI_MODEL=

# --- WhatsApp Cloud API (Meta) — only if WHATSAPP_SEND_VIA=cloudapi ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your number in international format without +, e.g. 919800000000
WHATSAPP_TO=
# Optional: approved template name. Needed when you haven't messaged the
# business number in the last 24h (Meta's customer-service window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
