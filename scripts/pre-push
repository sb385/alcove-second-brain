#!/bin/sh
# Back up a password changed on the website before this push redeploys the
# site (which wipes it). Installed with: git config core.hooksPath scripts
cd "$(git rev-parse --show-toplevel)" || exit 0
PY=.venv/Scripts/python.exe
[ -x "$PY" ] || PY=python
"$PY" -m secondbrain.backup_auth || true
exit 0
